# Copy to .env to override the defaults used by docker compose.
GATEWAY_PORT=8080
POSTGRES_PORT=5433

# Sign-in (or per run: make dev sso=dev|off|keycloak)
#   dev  — SSO through a stand-in IdP that signs in SSO_DEV_USERNAME at once (default)
#   off  — no SSO: username and password only
#   oidc — a real OpenID Connect IdP: set OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET below
SSO_MODE=dev
# The account the stand-in IdP signs in (alon.cohen | elad.biton | portal.admin)
SSO_DEV_USERNAME=alon.cohen
# Your organization's IdP, for SSO_MODE=oidc. Register http://localhost:8080/AI/api/auth/sso/callback as its redirect URI.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Always run with the local Keycloak IdP (same as make dev sso=keycloak):
# COMPOSE_FILE=docker-compose.yml:docker-compose.sso.yml
KEYCLOAK_PORT=8180

# Required for docker-compose.prod.yml (generate with: openssl rand -hex 32)
JWT_SECRET=
